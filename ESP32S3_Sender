#include <esp_now.h>
#include <WiFi.h>
#include "esp_wifi.h"
#include <stddef.h>

// ── Configuration ────────────────────────────────────────────────────────────

// Receiver MAC address – update this to match your receiver board
uint8_t receiverAddress[] = {0x24, 0xEC, 0x4A, 0x7E, 0xAC, 0x54};

#define NUM_BUTTONS      10
#define DEBOUNCE_US      5000   // 5 ms button debounce window
#define SEND_INTERVAL_MS 10     // Periodic send rate (100 Hz)

// Button GPIO pins
const uint8_t BUTTON_PINS[NUM_BUTTONS] = {16, 36, 18, 37, 39, 17, 35, 15, 10, 9};

// D-Pad GPIO pins
const uint8_t UP_PIN    = 6;
const uint8_t DOWN_PIN  = 41;
const uint8_t LEFT_PIN  = 5;
const uint8_t RIGHT_PIN = 4;

// ── Packet structure (must match receiver exactly) ────────────────────────────

typedef struct struct_message {
  uint32_t buttonStates;  // Bitmask: bit N = button N pressed
  int8_t   joystickX;     // -127 (left) … 127 (right)
  int8_t   joystickY;     // -127 (up)   … 127 (down)
  uint8_t  crc;           // CRC-8 over the preceding 6 bytes
} struct_message;

// ── CRC-8 (poly 0x07) – must be identical in sender and receiver ─────────────

static uint8_t crc8(const uint8_t *data, size_t len) {
  uint8_t crc = 0;
  for (size_t i = 0; i < len; i++) {
    crc ^= data[i];
    for (int j = 0; j < 8; j++)
      crc = (crc & 0x80) ? ((crc << 1) ^ 0x07) : (crc << 1);
  }
  return crc;
}

// ── Shared state (ISR ↔ loop) ─────────────────────────────────────────────────

static portMUX_TYPE mux = portMUX_INITIALIZER_UNLOCKED;
static struct_message myData;
volatile bool dataChanged = false;

// Previous states used inside the ISR only
static uint32_t prevButtonStates = 0xFFFFFFFF;  // Force first-send on boot
static int8_t   prevJoystickX    = 0;
static int8_t   prevJoystickY    = 0;

// Debounce: last ISR fire time in microseconds
static volatile int64_t lastDebounceUs = 0;

// ── ISR ───────────────────────────────────────────────────────────────────────

void IRAM_ATTR handleInputChange() {
  // Reject bounces within the debounce window
  int64_t now = esp_timer_get_time();
  if ((now - lastDebounceUs) < DEBOUNCE_US) return;
  lastDebounceUs = now;

  // Sample buttons
  uint32_t buttonStates = 0;
  for (int i = 0; i < NUM_BUTTONS; i++) {
    if (digitalRead(BUTTON_PINS[i]) == LOW)
      buttonStates |= (1u << i);
  }

  // Sample D-Pad
  int8_t xPos = 0, yPos = 0;
  if      (digitalRead(LEFT_PIN)  == LOW) xPos = -127;
  else if (digitalRead(RIGHT_PIN) == LOW) xPos =  127;
  if      (digitalRead(UP_PIN)    == LOW) yPos = -127;
  else if (digitalRead(DOWN_PIN)  == LOW) yPos =  127;

  if (buttonStates != prevButtonStates || xPos != prevJoystickX || yPos != prevJoystickY) {
    prevButtonStates = buttonStates;
    prevJoystickX    = xPos;
    prevJoystickY    = yPos;

    // Atomically update the shared packet
    portENTER_CRITICAL_ISR(&mux);
    myData.buttonStates = buttonStates;
    myData.joystickX    = xPos;
    myData.joystickY    = yPos;
    myData.crc          = crc8((const uint8_t *)&myData, offsetof(struct_message, crc));
    dataChanged         = true;
    portEXIT_CRITICAL_ISR(&mux);
  }
}

// ── ESP-NOW send callback ─────────────────────────────────────────────────────

void onDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  if (status != ESP_NOW_SEND_SUCCESS)
    Serial.println("[ESP-NOW] Send failed");
}

// ── Read real pin state and initialise myData / prevState ────────────────────

static void readInitialState() {
  uint32_t buttonStates = 0;
  for (int i = 0; i < NUM_BUTTONS; i++) {
    if (digitalRead(BUTTON_PINS[i]) == LOW)
      buttonStates |= (1u << i);
  }

  int8_t xPos = 0, yPos = 0;
  if      (digitalRead(LEFT_PIN)  == LOW) xPos = -127;
  else if (digitalRead(RIGHT_PIN) == LOW) xPos =  127;
  if      (digitalRead(UP_PIN)    == LOW) yPos = -127;
  else if (digitalRead(DOWN_PIN)  == LOW) yPos =  127;

  prevButtonStates    = buttonStates;
  prevJoystickX       = xPos;
  prevJoystickY       = yPos;
  myData.buttonStates = buttonStates;
  myData.joystickX    = xPos;
  myData.joystickY    = yPos;
  myData.crc          = crc8((const uint8_t *)&myData, offsetof(struct_message, crc));
}

// ── setup ─────────────────────────────────────────────────────────────────────

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();  // Do not join any network; ESP-NOW works standalone
  esp_wifi_set_max_tx_power(78);  // 20 dBm for maximum range

  if (esp_now_init() != ESP_OK) {
    Serial.println("[ESP-NOW] Init failed – halting");
    while (true) delay(1000);
  }

  esp_now_register_send_cb(onDataSent);

  esp_now_peer_info_t peerInfo;
  memset(&peerInfo, 0, sizeof(peerInfo));  // Zero-init to avoid garbage in reserved fields
  memcpy(peerInfo.peer_addr, receiverAddress, 6);
  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("[ESP-NOW] Failed to register peer – halting");
    while (true) delay(1000);
  }

  // Configure input pins
  for (int i = 0; i < NUM_BUTTONS; i++) {
    pinMode(BUTTON_PINS[i], INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(BUTTON_PINS[i]), handleInputChange, CHANGE);
  }
  pinMode(UP_PIN,    INPUT_PULLUP);
  pinMode(DOWN_PIN,  INPUT_PULLUP);
  pinMode(LEFT_PIN,  INPUT_PULLUP);
  pinMode(RIGHT_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(UP_PIN),    handleInputChange, CHANGE);
  attachInterrupt(digitalPinToInterrupt(DOWN_PIN),  handleInputChange, CHANGE);
  attachInterrupt(digitalPinToInterrupt(LEFT_PIN),  handleInputChange, CHANGE);
  attachInterrupt(digitalPinToInterrupt(RIGHT_PIN), handleInputChange, CHANGE);

  // Seed state from actual pin values so the first packet is accurate
  readInitialState();

  Serial.println("[ESP-NOW] Sender ready");
}

// ── loop ──────────────────────────────────────────────────────────────────────

static unsigned long lastSentTime = 0;

void loop() {
  bool shouldSend = false;
  struct_message snapshot;

  // Atomically check flag and snapshot the packet
  portENTER_CRITICAL(&mux);
  if (dataChanged || (millis() - lastSentTime >= SEND_INTERVAL_MS)) {
    snapshot    = myData;
    dataChanged = false;
    shouldSend  = true;
  }
  portEXIT_CRITICAL(&mux);

  if (shouldSend) {
    esp_err_t err = esp_now_send(receiverAddress, (uint8_t *)&snapshot, sizeof(snapshot));
    if (err != ESP_OK)
      Serial.printf("[ESP-NOW] Send error: %s\n", esp_err_to_name(err));
    lastSentTime = millis();
  }
}
